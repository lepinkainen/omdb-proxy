# Copy to .env and fill in the real key. Never commit .env.

# Required. Your own OMDb API key (https://www.omdbapi.com/apikey.aspx).
# This is the ONE key the whole fleet of projects shares through this proxy.
OMDB_API_KEY=

# Optional, all have sane defaults:

# Address to listen on.
# ADDR=:8090

# Where the SQLite cache lives. Inside the container this should stay
# under the /data volume declared in compose.yaml.
# DB_PATH=/data/cache.db

# Requests forwarded upstream per UTC day. Kept below OMDb's real 1000/day
# limit on purpose, to leave headroom for a second run the same day.
# DAILY_BUDGET=900

# Override only for testing, or if OMDb ever changes its base URL.
# UPSTREAM_URL=https://www.omdbapi.com

# If set, incoming requests must present this value as the apikey query
# parameter or as "Authorization: Bearer <token>". Left unset, the proxy
# accepts any client and is an open proxy on whatever network it's
# reachable from — fine on a private LAN, not fine on the open internet.
# PROXY_TOKEN=

# TTL for Response:"False" misses (Go duration syntax, e.g. 168h, 24h).
# See the README's caching policy table for why this is finite rather
# than permanent.
# NOTFOUND_TTL=168h

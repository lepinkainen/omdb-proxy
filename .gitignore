.env

# The built binary at the repo root (e.g. `go build -o omdb-proxy ./cmd/omdb-proxy`).
# Rooted so it doesn't also match cmd/omdb-proxy/, the source package.
/omdb-proxy

*.db
*.db-*

# The bind-mounted cache directory, if compose.prod.yaml is ever run from a
# checkout rather than from ~/docker/omdb-proxy/.
/data/

# Taskfile build output.
/build/
